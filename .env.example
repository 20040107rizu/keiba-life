# 競馬ライフ：オンライン対戦（Firebase）の設定
# このファイルを .env.local にコピーして、Firebase コンソールの値を入れてください。
# 4つの必須項目のどれかが空なら、ひとり用モード（端末だけに保存）で動きます。
# ※ これらは Web アプリ用の公開設定値です（ブラウザに配られます）。データは firestore.rules で守ります。

# 必須
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 任意（コンソールに表示されていれば入れておく）
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# 開発用：true にすると、ローカルの Firebase エミュレータ（Auth:9099 / Firestore:8080）につなぐ
NEXT_PUBLIC_FIREBASE_EMULATOR=
